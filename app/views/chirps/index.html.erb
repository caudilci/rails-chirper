<div>
  <h1 class="font-bold text-4xl">Chirps#index</h1>
  <p>Find me in app/views/chirps/index.html.erb</p>
  <%= form_for :chirp, url: "/chirps", method: :post do |form| %>
    <%= form.label :message, "Create a chirp:" %>
    <%= form.text_field :message %>
    <%= form.submit "Chirp" %>
  <% end %>
  <div>
    <% @chirps.each do |chirp| %>
        <div>
            <%= chirp.message %>
            <%= User.find(chirp.user_id).email_address %>
            <% if chirp.created_at != chirp.updated_at %>
                <p>Edited <%= chirp.updated_at %></p>
            <% else %>
                <%= chirp.created_at %>
            <% end %>
            <% if chirp.user_id == Current.user.id %>
                <%= link_to "Edit", controller: "chirps", action: "edit", id: chirp %>
                <%= form_for :chirp, url: "/chirps/#{chirp.id}", method: :delete do |form| %>
                    <%= form.submit "Delete" %>
                <% end %>
            <% end %>
        </div>
    <% end %>
  </div>
</div>
